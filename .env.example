# ==============================================================
# ZeroTrack Video Studio - Environment Configuration
# Copy this file to .env.local to configure your API keys:
# cp .env.example .env.local
# ==============================================================

# Background Image Generation (FLUX Klein via fal.ai)
# Get your key at: https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: Server-level LLM Script Generation Keys
# (You can also enter these directly in the web UI under AI Model Settings)

# Groq (Ultra-fast Llama 3.3 70B): https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (GPT-4o): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (Multi-model aggregator): https://openrouter.ai/keys
OPENROUTER_API_KEY=
